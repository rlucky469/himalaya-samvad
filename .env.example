# Public site URL (used for canonical URLs, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL=https://www.himalayasamvad.in

# Node.js backend base URL (auth, forms, magazine access)
NEXT_PUBLIC_API_BASE_URL=http://localhost:5000/api/v1

# true = forms and login work with fake responses until the backend is ready
NEXT_PUBLIC_API_MOCK=true

# Secret used to sign short-lived magazine page URLs (use a long random string)
MAGAZINE_SIGNING_SECRET=change-this-to-a-long-random-string

# How long a signed magazine page URL stays valid, in seconds
MAGAZINE_URL_TTL_SECONDS=600
